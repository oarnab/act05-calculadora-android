<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            style="@style/CalculatorResult"
            android:id="@+id/txtResultat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0" />
    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:stretchColumns="*">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonFunction"
                android:id="@+id/buttonM1"
                android:text="M-" />

            <Button
                style="@style/CalculatorButtonFunction"
                android:id="@+id/buttonM2"
                android:text="M+" />

            <Button
                style="@style/CalculatorButtonFunction"
                android:id="@+id/buttonM3"
                android:text="MC" />

            <Button
                style="@style/CalculatorButtonFunction"
                android:id="@+id/buttonM4"
                android:text="MR" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button7"
                android:text="7" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button8"
                android:text="8" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button9"
                android:text="9" />

            <Button
                style="@style/CalculatorButtonOperator"
                android:id="@+id/buttonDividir"
                android:text="/" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button4"
                android:text="4" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button5"
                android:text="5" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button6"
                android:text="6" />

            <Button
                style="@style/CalculatorButtonOperator"
                android:id="@+id/buttonX"
                android:text="×" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button1"
                android:text="1" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button2"
                android:text="2" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button3"
                android:text="3" />

            <Button
                style="@style/CalculatorButtonOperator"
                android:id="@+id/buttonResta"
                android:text="-" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonClear"
                android:id="@+id/buttonC"
                android:text="C" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/button0"
                android:text="0" />

            <Button
                style="@style/CalculatorButtonNumber"
                android:id="@+id/buttonComma"
                android:text="." />

            <Button
                style="@style/CalculatorButtonOperator"
                android:id="@+id/buttonMes"
                android:text="+" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                style="@style/CalculatorButtonFunction"
                android:id="@+id/buttonDelete"
                android:layout_span="2"
                android:contentDescription="Eliminar último carácter"
                android:text="⌫" />

            <Button
                style="@style/CalculatorButtonEquals"
                android:id="@+id/buttonIgual"
                android:layout_span="2"
                android:text="=" />
        </TableRow>
    </TableLayout>

</LinearLayout>
